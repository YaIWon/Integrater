# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=UniversalIntegratorPro
APP_VERSION=4.0.0

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ==========================================
# DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integrator
DB_USER=integrator
DB_PASSWORD=integrator_password
DB_SSL=false

# ==========================================
# REDIS (Caching)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ==========================================
# ETHEREUM / BLOCKCHAIN
# ==========================================
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
ETHEREUM_WS_URL=wss://mainnet.infura.io/ws/v3/your_infura_project_id
ETHEREUM_CHAIN_ID=1
ETHEREUM_NETWORK=mainnet
ETHERSCAN_API_KEY=your_etherscan_api_key
CONTRACT_DEPLOYER_PRIVATE_KEY=your_private_key_here_never_commit_this

# ==========================================
# API CONFIGURATION
# ==========================================
API_BASE_URL=https://api.example.com
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# ==========================================
# FILE UPLOAD - COMPLETE UNIVERSAL SUPPORT
# ==========================================
MAX_FILE_SIZE=1073741824  # 1GB
MAX_FILES_PER_UPLOAD=500
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# ==========================================
# ALL FILE TYPES - COMPLETE LIST
# ==========================================
# Web & Code
ALLOWED_EXTENSIONS=html,htm,xhtml,css,scss,sass,less,js,jsx,ts,tsx,json,json5,yml,yaml,toml,xml,xsd,xsl,xslt

# Languages
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},py,pyc,pyo,rb,go,rs,rslib,c,cpp,cxx,h,hpp,java,class,jar,kt,kts,swift,php,php3,php4,php5,php7,phar,lua,pl,pm,tcl,sh,bash,zsh,fish,ps1,psm1,cmd,bat

# Solidity & Blockchain
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},sol,vyper,yul,abi,bin,evm,wasm,wast

# Executables & Binaries
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},exe,msi,app,deb,rpm,pkg,dmg,apk,ipa,xapk,crx,nexe,elf,out,o,obj,lib,a,so,dylib,dll,sys,drv

# Archives & Compressed
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},zip,rar,7z,tar,gz,bz2,xz,zst,lz4,lzma,tgz,tbz,txz,zipx,sitx,arj,zoo,lzh,iso,img,dmg,pkg,bin,cue,nrg,mdf,mds

# Documents & Office
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},pdf,doc,docx,dot,dotx,odt,ott,rtf,txt,log,md,markdown,tex,latex,aux,sty,cls,bib,bst

# Spreadsheets & Data
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},xls,xlsx,xlsm,xlsb,ods,ots,csv,tsv,psv,tab,data,dat,db,sqlite,db3,accdb,mdb,fdb

# Presentations
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},ppt,pptx,pps,ppsx,odp,otp,key,theme

# Images - All Formats
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},jpg,jpeg,jfif,png,gif,bmp,tiff,tif,webp,avif,heif,heic,ico,cur,svg,svgz,psd,ai,eps,pdf,raw,cr2,nef,arw,dng,orf,raf

# Audio - All Formats
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},mp3,mp2,wav,flac,alac,aac,ogg,opus,webm,m4a,m4b,aiff,aif,wma,amr,ac3,dts,mid,midi,kar

# Video - All Formats
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},mp4,m4v,avi,mov,qt,wmv,asf,flv,f4v,rm,rmvb,webm,mkv,mxf,ogv,ogm,3gp,3g2,ts,m2ts,mts,vob

# CAD & 3D
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},dwg,dxf,dwf,iges,igs,step,stp,stl,obj,3ds,fbx,blend,skp,glb,gltf,usd,usdz

# Fonts
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},ttf,otf,woff,woff2,eot,svg,dfont

# E-books
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},epub,mobi,azw,azw3,fb2,djvu,lit,prc

# GIS & Mapping
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},shp,shx,dbf,prj,qix,kml,kmz,gpx,geojson,topojson

# Database & Data Exchange
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},sql,psql,mysql,jsonl,ndjson,avro,parquet,feather,arrow,orc,protobuf,pb,proto

# Configuration & System
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},conf,config,cfg,ini,properties,env,reg,plist,manifest,lock,lockfile

# Science & Research
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},ipynb,r,rdata,rds,rmd,stan,jl,m,mat,nb,model

# Game Files
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},rom,nes,snes,n64,iso,cso,elf,nds,gba,gbc,gb,psx,ps2,psp,wbfs,ciso

# Security & Crypto
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},pem,key,crt,csr,p12,pfx,jks,keystore,asc,pgp,gpg,ssh,rsa

# Virtual Machine & Container
ALLOWED_EXTENSIONS=${ALLOWED_EXTENSIONS},ova,ovf,vmdk,vhd,vhdx,raw,qcow2,img,vdi

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# ==========================================
# MONITORING
# ==========================================
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_SOLIDITY_VERIFICATION=true
ENABLE_AUTO_DEPLOYMENT=false
ENABLE_AI_ANALYSIS=false
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_BINARY_ANALYSIS=true
ENABLE_VIRUS_SCAN=true

# ==========================================
# DEBUGGING (Development Only)
# ==========================================
DEBUG=false
DEV_TOOLS=false
PRETTY_LOGS=true
