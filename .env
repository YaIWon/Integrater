# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=UniversalIntegrator
APP_VERSION=4.0.0

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ==========================================
# DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integrator
DB_USER=integrator
DB_PASSWORD=integrator_password
DB_SSL=false

# ==========================================
# REDIS (Caching)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ==========================================
# ETHEREUM / BLOCKCHAIN
# ==========================================
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
ETHEREUM_WS_URL=wss://mainnet.infura.io/ws/v3/your_infura_project_id
ETHEREUM_CHAIN_ID=1
ETHEREUM_NETWORK=mainnet
ETHERSCAN_API_KEY=your_etherscan_api_key
CONTRACT_DEPLOYER_PRIVATE_KEY=your_private_key_here_never_commit_this

# ==========================================
# API CONFIGURATION
# ==========================================
API_BASE_URL=https://api.example.com
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# ==========================================
# FILE UPLOAD
# ==========================================
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=100
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
ALLOWED_EXTENSIONS=html,css,js,json,py,sol,xml,txt,md,csv,png,jpg,jpeg,gif,webp,mp3,wav,ogg,mp4,webm,avi,wasm

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# ==========================================
# MONITORING
# ==========================================
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_SOLIDITY_VERIFICATION=true
ENABLE_AUTO_DEPLOYMENT=false
ENABLE_AI_ANALYSIS=false
ENABLE_EXPERIMENTAL_FEATURES=false

# ==========================================
# DEBUGGING (Development Only)
# ==========================================
DEBUG=false
DEV_TOOLS=false
PRETTY_LOGS=true
