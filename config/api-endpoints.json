  "integration": {
    "analyze": {
      "snippet": {
        "url": "https://api.snippet.org/v1/analyze",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        }
      },
      "pastebin": {
        "url": "https://pastebin.com/api/api_post.php",
        "method": "POST"
      },
      "gist": {
        "url": "https://api.github.com/gists",
        "method": "POST",
        "headers": {
          "Accept": "application/vnd.github.v3+json"
        }
      },
      "github": {
        "url": "https://api.github.com/repos/{owner}/{repo}/contents/{path}",
        "method": "GET",
        "headers": {
          "Accept": "application/vnd.github.v3+json"
        }
      },
      "gitlab": {
        "url": "https://gitlab.com/api/v4/projects/{id}/repository/files/{path}",
        "method": "GET"
      },
      "bitbucket": {
        "url": "https://api.bitbucket.org/2.0/repositories/{workspace}/{repo}/src/{commit}/{path}",
        "method": "GET"
      }
    },
    "deploy": {
      "remix": {
        "url": "https://remix-api.ethereum.org/deploy",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "hardhat": {
        "url": "https://api.hardhat.org/v1/deploy",
        "method": "POST"
      },
      "truffle": {
        "url": "https://api.trufflesuite.com/v1/deploy",
        "method": "POST"
      }
    },
    "verify": {
      "etherscan": {
        "url": "https://api.etherscan.io/api",
        "method": "GET",
        "params": {
          "module": "contract",
          "action": "verifysourcecode"
        }
      },
      "polygonscan": {
        "url": "https://api.polygonscan.com/api",
        "method": "GET",
        "params": {
          "module": "contract",
          "action": "verifysourcecode"
        }
      },
      "arbiscan": {
