{
  "name": "universal-integrator-pro",
  "version": "4.0.0",
  "description": "Enterprise-grade Universal File Integration System with Solidity support - The Most Advanced File Integration System Ever Built",
  "main": "dist/index.html",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:client": "npx serve . -p 3000",
    "dev:api": "node server.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:watch": "webpack --mode development --watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage && open coverage/lcov-report/index.html",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write 'js/**/*.js' 'css/**/*.css' '**/*.json'",
    "format:check": "prettier --check 'js/**/*.js' 'css/**/*.css'",
    "precommit": "npm run lint && npm run test",
    "prepush": "npm run test && npm run build",
    "clean": "rm -rf dist/ coverage/ node_modules/",
    "clean:cache": "rm -rf .cache/ .parcel-cache/",
    "docker:build": "docker build -t universal-integrator .",
    "docker:run": "docker run -p 3000:3000 universal-integrator",
    "docker:stop": "docker stop universal-integrator || true",
    "docker:rm": "docker rm universal-integrator || true",
    "deploy": "npm run build && npm run docker:build",
    "deploy:pages": "npm run build && gh-pages -d dist --no-history",
    "deploy:all": "node deploy-all.js",
    "release": "npm run build && npm test && npm run deploy:pages",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "postversion": "git push && git push --tags",
    "setup": "npm install && npm run build && npm run test",
    "update": "npm update && npm run build"
  },
  "keywords": [
    "file-integrator",
    "solidity",
    "smart-contracts",
    "ethereum",
    "blockchain",
    "web3",
    "universal-integration",
    "enterprise",
    "production",
    "file-analysis",
    "code-analysis",
    "github-integration",
    "api-integration",
    "archive-extraction",
    "binary-analysis",
    "html-parser",
    "css-parser",
    "javascript-parser",
    "python-parser",
    "json-parser",
    "xml-parser",
    "yaml-parser",
    "markdown-parser",
    "csv-parser",
    "sql-parser"
  ],
  "author": {
    "name": "SonicForge Industries",
    "email": "info@sonicforge.io",
    "url": "https://sonicforge.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonicforge/universal-integrator"
  },
  "bugs": {
    "url": "https://github.com/sonicforge/universal-integrator/issues"
  },
  "homepage": "https://sonicforge.github.io/universal-integrator",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0",
    "yarn": ">=1.22.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sonicforge"
  },
  "dependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "solidity-parser": "^0.16.0",
    "uuid": "^9.0.0",
    "winston": "^3.9.0",
    "axios": "^1.4.0",
    "adm-zip": "^0.5.10",
    "tar": "^6.1.15",
    "unzipper": "^0.10.11",
    "csv-parser": "^3.0.0",
    "xml2js": "^0.5.0",
    "js-yaml": "^4.1.0",
    "marked": "^5.1.0",
    "highlight.js": "^11.8.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.22.0",
    "@types/node": "^20.3.0",
    "babel-loader": "^9.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.0",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.5.0",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.9.0",
    "gh-pages": "^6.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "@babel/eslint-parser": "^7.22.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js",
      "!js/**/*.spec.js",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/coverage/"
    ],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "verbose": true
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "16"
          }
        }
      ]
    ],
    "plugins": [
      "@babel/plugin-transform-runtime"
    ]
  },
  "eslintConfig": {
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module",
      "ecmaFeatures": {
        "modules": true
      }
    },
    "env": {
      "browser": true,
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:import/recommended",
      "plugin:jest/recommended",
      "prettier"
    ],
    "rules": {
      "no-console": "off",
      "no-debugger": "warn",
      "no-unused-vars": "warn",
      "import/no-unresolved": "off",
      "import/no-named-as-default": "off"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not IE 11"
  ]
}
