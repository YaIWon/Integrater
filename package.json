{
  "name": "universal-integrator-pro",
  "version": "4.0.0",
  "description": "Enterprise-grade Universal File Integration System with Solidity support",
  "main": "dist/index.html",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write 'js/**/*.js' 'css/**/*.css'",
    "precommit": "npm run lint && npm run test",
    "docker:build": "docker build -t universal-integrator .",
    "docker:run": "docker run -p 3000:3000 universal-integrator",
    "deploy": "npm run build && npm run docker:build"
  },
  "keywords": [
    "file-integrator",
    "solidity",
    "smart-contracts",
    "ethereum",
    "blockchain",
    "web3",
    "universal-integration",
    "enterprise",
    "production"
  ],
  "author": "SonicForge Industries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonicforge/universal-integrator"
  },
  "bugs": {
    "url": "https://github.com/sonicforge/universal-integrator/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "solidity-parser": "^0.16.0",
    "uuid": "^9.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.22.0",
    "@types/node": "^20.3.0",
    "babel-loader": "^9.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.0",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.5.0",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.9.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less)$": "identity-obj-proxy"
    },
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
